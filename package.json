{
	"name": "@mimo-codex/dsh-promptbook",
	"description": "提示词簿 DSH 插件：资源包分层解析（模型→供应商→默认）、按模型改写系统提示词与工具描述（装配层注入 + dispatch 兜底，仅 llm-mimo 托管模型生效）、设置页逐键编辑卡与编译层覆盖接口",
	"version": "0.1.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"models",
		"registry.json",
		"cordis.patch.yml",
		"README.md",
		"AGENTS.md",
		"LICENSE"
	],
	"license": "MIT",
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.4",
		"@mimo-codex/dsh-llm-mimo": ">=0.2.0"
	},
	"scripts": {
		"verify:install": "node scripts/verify-install.mjs",
		"ci": "node scripts/ci.mjs",
		"test": "node test/promptbook.test.mjs && node test/inject.test.mjs && node test/client.test.mjs"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "~3.18.4"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-settings"
			],
			"platform": "web"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dalizi2333/dsh-promptbook.git"
	},
	"homepage": "https://github.com/dalizi2333/dsh-promptbook#readme",
	"keywords": [
		"dsh",
		"deepseek-harness",
		"mimo",
		"prompt",
		"system-prompt"
	]
}